<?xml version="1.0" encoding="utf-8"?>
<!-- Hairline separator at 10% white (BRAND-GUIDE.md §3.2 `line`). Flat, no
     fill: the row is text on Ink, not a button competing for attention. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:top="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/pxx_white_10" />
        </shape>
    </item>
</layer-list>
