<?xml version="1.0" encoding="utf-8"?>
<!-- Input well: `slate` fill with a 10%-white hairline (BRAND-GUIDE.md §3.2). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pxx_slate" />
    <stroke
        android:width="1dp"
        android:color="@color/pxx_white_10" />
    <corners android:radius="8dp" />
</shape>
