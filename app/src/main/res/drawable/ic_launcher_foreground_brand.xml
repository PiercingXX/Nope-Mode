<?xml version="1.0" encoding="utf-8"?>
<!--
  Nope-Mode mark: a circle struck through. The app makes chosen apps silent and
  un-openable, and the name is already the answer, so the mark says it straight.

  The bar runs at 45°, the same angle as the logomark's crossing strokes, and
  its round caps land on the circle's stroke band — r=17, endpoints 11 units off
  centre on each axis, so the cap kisses the ring instead of spilling past it.

  This is the adaptive-icon FOREGROUND; the Ink tile is the background layer.
  House glyph language (BRAND-GUIDE.md §5): 108 viewport, Signal stroke, width 4,
  round caps, no fills. Inside x,y 35..73, so it clears the 66dp safe zone and
  survives any mask the launcher applies.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M54,54 m-17,0 a17,17 0 1,1 34,0 a17,17 0 1,1 -34,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:fillColor="#00000000" />

    <path
        android:pathData="M43,65 L65,43"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

</vector>
