<?xml version="1.0" encoding="utf-8"?>
<!--
  PiercingXX logomark (BRAND-GUIDE.md §5): an X of two bars crossing at ±45° in
  Signal white, underlined by a white bar, on Ink.

  Traced from branding/assets/logomark.svg. That master is a 512 tile; this is
  the adaptive-icon FOREGROUND, so it is drawn on the same 512 grid but scaled
  to ~60% about the centre to sit inside the adaptive icon's safe zone — the
  outer ~1/3 of an adaptive icon can be masked away, and §5 asks for at least a
  bar-width of clear space on all sides regardless of mask shape.

  The Ink tile is the background layer, not this one.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.6"
        android:scaleY="0.6">

        <!-- The two crossing bars. Rounded ends (rx=36 in the master). -->
        <group
            android:pivotX="256"
            android:pivotY="220"
            android:rotation="45">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M256,70 m-36,0 l72,0 a36,36 0 0 1 36,36 l0,228 a36,36 0 0 1 -36,36 l-72,0 a36,36 0 0 1 -36,-36 l0,-228 a36,36 0 0 1 36,-36 z" />
        </group>
        <group
            android:pivotX="256"
            android:pivotY="220"
            android:rotation="-45">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M256,70 m-36,0 l72,0 a36,36 0 0 1 36,36 l0,228 a36,36 0 0 1 -36,36 l-72,0 a36,36 0 0 1 -36,-36 l0,-228 a36,36 0 0 1 36,-36 z" />
        </group>

        <!-- The white underline. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M183,378 l146,0 a22,22 0 0 1 22,22 a22,22 0 0 1 -22,22 l-146,0 a22,22 0 0 1 -22,-22 a22,22 0 0 1 22,-22 z" />
    </group>

</vector>
