<?xml version="1.0" encoding="utf-8"?>
<!--
  One app row. Checkbox tints Signal green when checked (the theme's
  colorControlActivated) — that green tick is the single saturated thing on the
  screen, which is exactly the job §3.1 gives the accent.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <CheckBox
        android:id="@+id/appCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/appLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@string/font_body"
            android:textColor="@color/pxx_paper"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/appPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@string/font_body"
            android:textColor="@color/pxx_white_50"
            android:textSize="12sp" />

        <!-- Warn amber, because a reason a row cannot be picked (or a caution
             about picking it) is status, not decoration (§3.5). -->
        <TextView
            android:id="@+id/appReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@string/font_body"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/pxx_warn"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
