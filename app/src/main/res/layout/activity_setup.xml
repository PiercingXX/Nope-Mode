<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleText"
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tierText"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/setupText"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/fallbackGrantsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/listenerStatus"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/grantListenerButton"
                style="@style/Button.Signal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/grant_listener" />

            <TextView
                android:id="@+id/accessibilityStatus"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/grantAccessibilityButton"
                style="@style/Button.Signal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/grant_accessibility" />
        </LinearLayout>

        <Button
            android:id="@+id/grantDndButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/grant_dnd" />

        <Button
            android:id="@+id/grantExactAlarmButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_exact_alarm" />

        <TextView
            android:id="@+id/relinquishHint"
            style="@style/Text.Warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/relinquish_hint"
            android:visibility="gone" />

        <Button
            android:id="@+id/relinquishButton"
            style="@style/Button.Signal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/relinquish_title"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
