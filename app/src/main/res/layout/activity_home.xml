<?xml version="1.0" encoding="utf-8"?>
<!--
  Home, shaped like Focus Mode's single screen: what it does, when it runs,
  a turn-on-now control, then the app list. In PiercingXX house style
  (BRAND-GUIDE.md §3, §4) — Ink ground, mono, one accent.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stateText"
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/blockedCountText"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/home_blurb" />

        <!-- Design §11 requires a master toggle; without it a tile tap inside a
             schedule window left no way to turn enforcement off at all. -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/masterSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/font_body"
            android:text="@string/master_enabled"
            android:textColor="@color/pxx_white_90"
            android:textSize="15sp" />

        <Button
            android:id="@+id/scheduleButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_a_schedule" />

        <Button
            android:id="@+id/turnOnNowButton"
            style="@style/Button.Signal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/turn_on_now" />

        <Button
            android:id="@+id/takeABreakButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/take_a_break"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tierText"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/warningText"
            style="@style/Text.Warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/provisionText"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textIsSelectable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/pxx_white_10" />

        <Button
            android:id="@+id/blockedAppsButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blocked_apps_title" />
        <View style="@style/Divider" />

        <Button
            android:id="@+id/settingsButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />
        <View style="@style/Divider" />

        <Button
            android:id="@+id/backupButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_title" />
        <View style="@style/Divider" />

        <Button
            android:id="@+id/setupButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title" />
        <View style="@style/Divider" />

    </LinearLayout>

</ScrollView>
