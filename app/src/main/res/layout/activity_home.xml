<?xml version="1.0" encoding="utf-8"?>
<!--
  Home, in PiercingXX house style (BRAND-GUIDE.md §3, §4).

  Ink ground, mono type, left-aligned, hierarchy from opacity rather than from
  colour. The nav is a hairline-separated list, not five filled buttons — §1
  calls for minimal / low-noise surfaces where the interface gets out of the way,
  and five saturated pills would break §3.1's rule of one accent.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pxx_ink"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stateText"
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/blockedCountText"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tierText"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <!-- Warnings are the one place a second colour is allowed, and only
             because §3.5 status colours are semantic, never decorative. -->
        <TextView
            android:id="@+id/warningText"
            style="@style/Text.Warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/provisionText"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textIsSelectable="true" />

        <!-- Design §11 requires a master toggle on Home. Without it, a user
             inside a schedule window has no off switch at all: the tile only
             flips ForceOn, and a break is bounded and rate-limited. -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/masterSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@string/font_body"
            android:text="@string/master_enabled"
            android:textColor="@color/pxx_white_90"
            android:textSize="15sp" />

        <!-- Focus Mode parity (design §1): a bounded break, offered as 5/15/30.
             Signal green because while active this is the action on the screen. -->
        <Button
            android:id="@+id/breakButton"
            style="@style/Button.Signal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/take_a_break" />

        <TextView
            android:id="@+id/breakReasonText"
            style="@style/Text.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/pxx_white_10" />

        <Button
            android:id="@+id/blockedAppsButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blocked_apps_title" />
        <View style="@style/Divider" />

        <Button
            android:id="@+id/schedulesButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/schedules_title" />
        <View style="@style/Divider" />

        <Button
            android:id="@+id/settingsButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />
        <View style="@style/Divider" />

        <Button
            android:id="@+id/backupButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_title" />
        <View style="@style/Divider" />

        <Button
            android:id="@+id/setupButton"
            style="@style/Nav.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title" />
        <View style="@style/Divider" />

    </LinearLayout>

</ScrollView>
