<?xml version="1.0" encoding="utf-8"?>
<!--
  Search is pinned to the BOTTOM and borderless, the way PiercingXX-Launcher's
  app drawer does it: a phone is held low, and a search field at the top of a
  long list is the one control you cannot reach while scrolling it. Borderless
  because the launcher's drawer field has no box either — the list is the
  interface, the field is just where the caret is.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="28dp">

    <TextView
        android:id="@+id/titleText"
        style="@style/Text.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/blocked_apps_title"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/emptyText"
        style="@style/Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/blocked_apps_empty"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:fontFamily="@string/font_body"
        android:hint="@string/blocked_apps_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:textColor="@color/pxx_white_90"
        android:textColorHint="@color/pxx_white_50"
        android:textSize="16sp" />

</LinearLayout>
